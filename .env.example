# --- LLM providers ---
NIM_API_KEY=
TAVILY_API_KEY=
GEMINI_API_KEY=
VISION_MODEL=gemini-2.5-flash
CAPTURE_INTERVAL=30
CAPTURE_REGION=full
PIXEL_DIFF_THRESHOLD=2.0
NEWS_CACHE_TTL=300
REASONING_MODEL=moonshotai/kimi-k2.6
NEWS_MODEL=meta/llama-3.3-70b-instruct

# Optional: run the vision stage on a faster provider (recommended for speed).
# Set VISION_API_KEY to activate; leave blank to keep vision on NVIDIA NIM.
# For Google Gemini (free key at https://aistudio.google.com/apikey):
#   VISION_API_KEY=your_google_ai_studio_key
#   VISION_MODEL=gemini-2.5-flash
#   VISION_BASE_URL defaults to Gemini's endpoint when VISION_API_KEY is set.
VISION_BASE_URL=
VISION_API_KEY=

# --- Market data ---
TWELVEDATA_API_KEY=

# --- Infra ---
REDIS_URL=
FRONTEND_ORIGIN=http://localhost:5173
ANALYSE_RATE_LIMIT=10/minute
